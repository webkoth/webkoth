# Public base URL (used in metadata, JSON-LD, sitemap)
NEXT_PUBLIC_BASE_URL=https://webkoth.com

# Telegram bot for landing lead form
# Create bot via @BotFather, get chat_id by sending /start to your bot then
# curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Lead email via hubmarket-ai relay ───────────────────────────
# Email is delivered via the hubmarket-ai microservice email relay
# (POST /api/email/send), because outbound SMTP from RU hosting is blocked.
# Configure SMTP itself in hubmarket-ai/.env (SMTP_HOST/PORT/USER/PASS).
# Here we only need the FROM display + the OWNER inbox + AI service creds.
SMTP_FROM="Минас Саркисян <support@hubmarket.ru>"
OWNER_EMAIL=webkoth@gmail.com

# AI microservice (hubmarket-ai) — Hono server with cascade Claude→Gemini→Groq
# Also acts as email relay (POST /api/email/send) for the lead forms.
# Local dev: http://localhost:3100  ·  Prod: https://ai.marketsellerai.ru
AI_SERVICE_URL=http://localhost:3100
AI_SERVICE_TOKEN=

# Номер счётчика Яндекс Метрики; без него счётчик не рендерится
NEXT_PUBLIC_YM_ID=
